# HRMS Enterprise Demo Environment Configuration
# This file contains dummy/development values only - not for production use

# OAuth2 Configuration (Dummy Mode)
OAUTH2_ENABLED=true
OAUTH2_PROVIDER=DUMMY
OAUTH2_DUMMY_MODE=true
OAUTH2_CLIENT_ID=demo-client-id
OAUTH2_CLIENT_SECRET=demo-client-secret
OAUTH2_AUTHORIZE_URL=https://dummy-auth.local/authorize
OAUTH2_TOKEN_URL=https://dummy-auth.local/token

# RBAC Configuration (Environment-driven)
RBAC_SOURCE=ENV
RBAC_CONFIG={"AMP":["*"],"HR":["employees.*","leave.*","onboard.*","policies.*","payroll.review"],"TA":["candidates.*","resume.analyze","screening.call"],"MANAGER":["team.view","team.approve","leave.approve","attendance.review"],"EMPLOYEE":["self.view","leave.apply","attendance.mark","payslip.view"]}
NEXT_PUBLIC_RBAC_CONFIG={"AMP":["*"],"HR":["employees.*","leave.*","onboard.*","policies.*","payroll.review"],"TA":["candidates.*","resume.analyze","screening.call"],"MANAGER":["team.view","team.approve","leave.approve","attendance.review"],"EMPLOYEE":["self.view","leave.apply","attendance.mark","payslip.view"]}

# JWT Configuration (Dummy keys for development)
JWT_PUBLIC_KEY=DUMMY_PUBLIC_KEY_FOR_DEV
JWT_PRIVATE_KEY=DUMMY_PRIVATE_KEY_FOR_DEV

# NextAuth Configuration
NEXTAUTH_SECRET=dummy-secret-for-development-only
NEXTAUTH_URL=http://localhost:3000

# Mock Data Seed
MOCK_DATA_SEED=true

# Feature Flags
ENABLE_FEATURE_AI_MODULES=true
ENABLE_ROLE_MANAGER=true
ENABLE_ROLE_TA=true
ENABLE_FEATURE_PAYMENTS=false

# Logging
LOG_LEVEL=info

# Database (not used in dummy mode, but kept for compatibility)
# MONGODB_URI=mongodb://localhost:27017/hrms_demo
